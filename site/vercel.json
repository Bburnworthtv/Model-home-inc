{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "device",
          "value": "mobile"
        }
      ],
      "destination": "/_variants/mobile/index.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "device",
          "value": "tablet"
        }
      ],
      "destination": "/_variants/tablet/index.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(?:iPad|Tablet).*"
        }
      ],
      "destination": "/_variants/tablet/index.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
